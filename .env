# Environment Variables for EmailJS

# Get these values from your EmailJS account (https://www.emailjs.com)
# After creating an account and email service:

# 1. Service ID - Found in Email Services section
VITE_EMAILJS_SERVICE_ID= 'service_2olpoue'

# 2. Template ID - Found in Email Templates section
VITE_EMAILJS_TEMPLATE_ID= 'template_kunndid'

# 3. Public Key - Found in Account > API Keys section
VITE_EMAILJS_PUBLIC_KEY= 'F0y9GGkxE7Q0CuKjI'
